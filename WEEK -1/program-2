#include <iostream>
using namespace std;

int main()
{
    int a, b;

    cout << "Enter a and b values: ";
    cin >> a >> b;

    cout << "Value of a is: " << a << endl;
    cout << "Value of b is: " << b << endl;

    a = a + b;
    b = a - b;
    a = a - b;

    cout << "After swapping value of a is: " << a << endl;
    cout << "After swapping value of b is: " << b << endl;

    return 0;
}
