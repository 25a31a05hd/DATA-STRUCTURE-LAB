#include <iostream>
using namespace std;

int main()
{
    int a, b;
    char op;

    cout << "Enter a and b values: ";
    cin >> a >> b;

    cout << "Enter operator (+, -, /, %): ";
    cin >> op;

    switch(op)
    {
        case '+':
            cout << "Addition: " << a + b;
            break;

        case '-':
            cout << "Subtraction: " << a - b;
            break;

        case '/':
            cout << "Division: " << a / b;
            break;

        case '%':
            cout << "Modulus: " << a % b;
            break;

        default:
            cout << "Invalid operator";
    }

    return 0;
}
