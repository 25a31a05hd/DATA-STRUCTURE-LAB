#include <iostream>
using namespace std;

int main() {
    int a[10], n, key, i;
    
    cout << "Enter n & key value: ";
    cin >> n >> key;

    // Input array elements (must be in sorted order for Binary Search)
    for (i = 0; i < n; i++) {
        cout << "Enter array element " << i + 1 << ": ";
        cin >> a[i];
    }

    int low = 0, high = n - 1, mid;
    bool found = false;

    // Binary search logic
    while (low <= high) {
        mid = (low + high) / 2;

        if (a[mid] == key) {
            cout << "Key found at location " << mid << endl;
            found = true;
            break;
        } 
        else if (a[mid] < key) {
            low = mid + 1;
        } 
        else {
            high = mid - 1;
        }
    }

    if (!found) {
        cout << key << " not found" << endl;
    }

    return 0;
}
