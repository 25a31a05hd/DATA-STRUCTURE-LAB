#include <iostream>
using namespace std;

int main() {
    int n, key, a[10], count = 0;

    // Input the number of elements and the search key
    cout << "Enter n and key: ";
    cin >> n >> key;

    // Input the array elements
    cout << "Enter array elements: " << endl;
    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }

    // Perform Linear Search
    for (int i = 0; i < n; i++) {
        if (a[i] == key) {
            cout << "Key found at location: " << i + 1 << endl;
            count++;
        }
    }

    // Display the total number of occurrences
    cout << "Key element available " << count << " times" << endl;

    return 0;
}
