#include <iostream>
using namespace std;

int main() {
    int n;
    cout << "Enter no. of elements: ";
    cin >> n;

    int arr; // Note: Variable-sized arrays are supported by some compilers (GCC), 
                // but not standard in all C++ versions.

    cout << "Enter elements: " << endl;
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    // Selection Sort Logic
    for (int i = 0; i < n; i++) {
        for (int j = i + 1; j < n; j++) {
            if (arr[i] > arr[j]) {
                // Swapping elements
                int temp = arr[i];
                arr[i] = arr[j];
                arr[j] = temp;
            }
        }
    }

    cout << "Sorted array: " << endl;
    for (int i = 0; i < n; i++) {
        cout << arr[i] << " ";
    }

    return 0;
}
