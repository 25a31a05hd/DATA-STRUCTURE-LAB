#include <iostream>
using namespace std;

int main() {
    int n;
    cout << "Enter no. of Elements: ";
    cin >> n;

    int arr; // Note: Variable Length Arrays (VLAs) are a C99 feature, not standard C++. 
                // For standard C++, use 'int *arr = new int;' or 'std::vector<int> arr(n);'

    cout << "Enter elements:\n";
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    // Bubble Sort Logic
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (arr[j] > arr[j + 1]) {
                // Swapping elements
                int temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }

    cout << "Sorted array:\n";
    for (int i = 0; i < n; i++) {
        cout << arr[i] << " ";
    }

    return 0;
}
