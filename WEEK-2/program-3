#include <iostream>
using namespace std;

int main() {
    int n, i;
    
    cout << "Enter total number of array elements: ";
    cin >> n;

    // Dynamic memory allocation
    int *p = new int;

    cout << "Enter array elements:" << endl;
    for (i = 0; i < n; i++) {
        cin >> *(p + i); // Or cin >> p[i];
    }

    cout << "\nArray elements are:" << endl;
    for (i = 0; i < n; i++) {
        cout << *(p + i) << " ";
    }

    // Deleting allocated memory to prevent memory leaks
    delete[] p; 

    return 0;
}
