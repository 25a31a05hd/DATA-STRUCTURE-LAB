#include <iostream>
using namespace std;

int main()
{
    int a[10], n, i;

    cout << "Enter total number of array elements: ";
    cin >> n;

    for(i = 0; i < n; i++)
    {
        cin >> a[i];
    }

    cout << "\nArray elements are: ";

    for(i = 0; i < n; i++)
    {
        cout << a[i] << " ";
    }

    return 0;
}
