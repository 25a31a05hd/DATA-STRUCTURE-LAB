#include <iostream>
using namespace std;

// Function declarations/definitions
int add(int a, int b, int c) {
    return a + b + c;
}

float add(int a, float b, int c) {
    return a + b + c;
}

float add(float a, float b, int c) {
    return a + b + c;
}

int main() {
    int a = 10, b = 30;
    float c = 30.5, d = 5.6;

    // Call 1: Matches (int, int, int)
    cout << "add = " << add(a, b, a) << endl; 

    // Call 2: Matches (int, float, int)
    cout << "float = " << add(a, c, b) << endl; 

    // Call 3: Matches (float, float, int)
    cout << "add = " << add(c, d, a) << endl;

    return 0;
}
