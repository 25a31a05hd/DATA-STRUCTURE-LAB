#include <iostream>
using namespace std; // Fixed: "std" instead of "stds"

class Addition {
private:
    int n;
    int *ptr;
    int sum;

public: // Fixed: Lowercase 'p' in "public"
    void getSize() { // Fixed: Removed space in function name
        cout << "Enter no. of elements: ";
        cin >> n;
        ptr = new int; // Fixed: "ptr" instead of "per"
    }

    void getElements() {
        cout << "Enter " << n << " elements:\n";
        for (int i = 0; i < n; i++) {
            cin >> ptr[i];
        }
    }

    void calculateSum() { // Fixed: Spelling "calculate"
        sum = 0;
        for (int i = 0; i < n; i++) {
            sum = sum + ptr[i];
        }
    }

    void displaySum() {
        cout << "Sum of elements = " << sum << endl;
    }

    // Destructor to free dynamic memory
    ~Addition() {
        delete[] ptr;
    }
};

int main() {
    Addition obj;
    obj.getSize();
    obj.getElements();
    obj.calculateSum();
    obj.displaySum();
    return 0;
}
