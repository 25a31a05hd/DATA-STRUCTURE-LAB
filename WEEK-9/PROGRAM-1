#include <iostream>
using namespace std;

#define MAX 5

int deque[MAX];
int front = -1, rear = -1;

// Insert at Front
void insertFront(int item)
{
    if((front == 0 && rear == MAX - 1) || (front == rear + 1))
    {
        cout << "Deque Overflow\n";
    }
    else if(front == -1)
    {
        front = rear = 0;
        deque[front] = item;
    }
    else if(front == 0)
    {
        front = MAX - 1;
        deque[front] = item;
    }
    else
    {
        front--;
        deque[front] = item;
    }
}

// Insert at Rear
void insertRear(int item)
{
    if((front == 0 && rear == MAX - 1) || (front == rear + 1))
    {
        cout << "Deque Overflow\n";
    }
    else if(front == -1)
    {
        front = rear = 0;
        deque[rear] = item;
    }
    else if(rear == MAX - 1)
    {
        rear = 0;
        deque[rear] = item;
    }
    else
    {
        rear++;
        deque[rear] = item;
    }
}

// Delete from Front
void deleteFront()
{
    if(front == -1)
    {
        cout << "Deque Underflow\n";
    }
    else
    {
        cout << deque[front] << " deleted from front\n";

        if(front == rear)
        {
            front = rear = -1;
        }
        else if(front == MAX - 1)
        {
            front = 0;
        }
        else
        {
            front++;
        }
    }
}

// Delete from Rear
void deleteRear()
{
    if(front == -1)
    {
        cout << "Deque Underflow\n";
    }
    else
    {
        cout << deque[rear] << " deleted from rear\n";

        if(front == rear)
        {
            front = rear = -1;
        }
        else if(rear == 0)
        {
            rear = MAX - 1;
        }
        else
        {
            rear--;
        }
    }
}

// Display Deque
void display()
{
    if(front == -1)
    {
        cout << "Deque is Empty\n";
        return;
    }

    cout << "Deque Elements: ";

    int i = front;

    while(i != rear)
    {
        cout << deque[i] << " ";
        i = (i + 1) % MAX;
    }

    cout << deque[rear] << endl;
}

int main()
{
    int choice, item;

    while(1)
    {
        cout << "\n--- DEQUE USING ARRAYS ---\n";
        cout << "1. Insert Front\n";
        cout << "2. Insert Rear\n";
        cout << "3. Delete Front\n";
        cout << "4. Delete Rear\n";
        cout << "5. Display\n";
        cout << "6. Exit\n";

        cout << "Enter your choice: ";
        cin >> choice;

        switch(choice)
        {
            case 1:
                cout << "Enter item: ";
                cin >> item;
                insertFront(item);
                break;

            case 2:
                cout << "Enter item: ";
                cin >> item;
                insertRear(item);
                break;

            case 3:
                deleteFront();
                break;

            case 4:
                deleteRear();
                break;

            case 5:
                display();
                break;

            case 6:
                return 0;

            default:
                cout << "Invalid Choice\n";
        }
    }

    return 0;
}
