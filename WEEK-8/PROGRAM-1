#include <iostream>
using namespace std;

int main()
{
    int s[10], top = -1, size, item, op;

    cout << "Enter stack size: ";
    cin >> size;

    do
    {
        cout << "\n1. PUSH";
        cout << "\n2. POP";
        cout << "\n3. PEEK";
        cout << "\n4. DISPLAY";
        cout << "\n5. EXIT";
        cout << "\nChoose any one option: ";
        cin >> op;

        switch(op)
        {
            case 1:
                if(top == size - 1)
                {
                    cout << "Stack is Overflow";
                }
                else
                {
                    top = top + 1;
                    cout << "Enter item: ";
                    cin >> item;
                    s[top] = item;
                }
                break;

            case 2:
                if(top == -1)
                {
                    cout << "Stack is Underflow";
                }
                else
                {
                    cout << s[top] << " is Popped";
                    top = top - 1;
                }
                break;

            case 3:
                if(top == -1)
                {
                    cout << "Stack is Empty";
                }
                else
                {
                    cout << "Top element is: " << s[top];
                }
                break;

            case 4:
                if(top == -1)
                {
                    cout << "Stack is Empty";
                }
                else
                {
                    cout << "Stack elements are:\n";
                    for(int i = top; i >= 0; i--)
                    {
                        cout << s[i] << " ";
                    }
                }
                break;

            case 5:
                cout << "Exiting...";
                break;

            default:
                cout << "Invalid Choice";
        }

    } while(op != 5);

    return 0;
}
